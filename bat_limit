
battery() {
    local START="${1:-}"
    local END="${2:-}"
    local HWDB_FILE="/etc/udev/hwdb.d/61-battery-local.hwdb"
     
    if [[ -z "$START" || -z "$END" ]]; then
        echo "Usage: battery <start> <end>"
        echo "Example: battery 50 55"
        return 1
    fi

  if [[ ! "$START" =~ ^([0-9]{1,2}|100|_)$ || ! "$END" =~ ^([0-9]{1,2}|100|_)$ ]]; then
    echo "Error: Start and end must be 0-100 or _."
    return 1
fi
  

    echo "Battery detected: $BATTERY"
    echo "Setting charge limit to ${START}%-${END}%..."

    if sudo grep -q '^ CHARGE_LIMIT=' "$HWDB_FILE"; then
        sudo sed -i \
            "s/^ CHARGE_LIMIT=.*/ CHARGE_LIMIT=${START},${END}/" \
            "$HWDB_FILE"
    else
        echo "Error: CHARGE_LIMIT key not found in $HWDB_FILE"
        return 1
    fi

    if sudo systemd-hwdb update; then
        echo "systemd-hwdb updated."

        if sudo udevadm trigger -v "/sys/class/power_supply/$BATTERY"; then
            echo "udevadm triggered successfully."
        else
            echo "Warning: udevadm trigger failed."
        fi
    else
        echo "Warning: systemd-hwdb update failed."
        return 1
    fi

    echo
    echo "Current battery charge thresholds:"

    if [[ -f "/sys/class/power_supply/$BATTERY/charge_control_start_threshold" ]]; then
        echo "Start threshold:"
        cat "/sys/class/power_supply/$BATTERY/charge_control_start_threshold"
    fi

    if [[ -f "/sys/class/power_supply/$BATTERY/charge_control_end_threshold" ]]; then
        echo "End threshold:"
        cat "/sys/class/power_supply/$BATTERY/charge_control_end_threshold"
    fi

    echo
    echo
    cat /etc/udev/hwdb.d/61-battery-local.hwdb
    echo
    echo
}

echo
echo
cat /etc/udev/hwdb.d/61-battery-local.hwdb
echo
echo
